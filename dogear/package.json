{
  "name": "dogear",
  "displayName": "Dogear",
  "description": "Pick up exactly where you left off — files, cursor, and AI context",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Dogear",
      "properties": {
        "focusMode.groqApiKey": {
          "type": "string",
          "default": "",
          "description": "Your Groq API key for AI-powered session summaries.",
          "markdownDescription": "Get a free key (no credit card) at https://console.groq.com"
        },
        "focusMode.captureTerminalLastCommand": {
          "type": "boolean",
          "default": true,
          "description": "Capture the most recent command per terminal tab when shell integration data is available."
        },
        "focusMode.restoreTerminalLastCommand": {
          "type": "boolean",
          "default": false,
          "description": "Replay captured terminal commands on resume. Disabled by default for safety."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "focusModeSessionList",
          "name": "Focus Sessions"
        }
      ]
    },
    "menus": {
      "view/item/context": [
        {
          "command": "focusMode.deleteSession",
          "when": "viewItem == focusSession",
          "group": "inline"
        }
      ]
    },
    "commands": [
      {
      "command": "focusMode.pause",
      "title": "Focus: Pause — Save Session"
      },
      {
        "command": "focusMode.resume",
        "title": "Focus: Resume a Session"
      },
      {
        "command": "focusMode.deleteSession",
        "title": "Delete",
        "icon": "$(trash)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.17",
    "@types/vscode": "^1.118.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "webpack": "^5.105.3",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "openai": "^6.35.0"
  }
}
